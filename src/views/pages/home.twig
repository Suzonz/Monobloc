{% extends "../layouts/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/assets/css/register.css"/>
{% endblock %}

{% block title %}
	<title>Ma collection - Monobloc</title>
{% endblock %}

{% block main %}
	<main>
		<section id="section-form" class="book-container">
			<h2>Bienvenue {{ user.firstName }}</h2>
			{% if error %}
				<p class="form-error">{{ error }}</p>
			{% elseif books is empty %}
				<p class="empty-collection">Ta collection est vide pour l'instant.</p>
				<a href="/addBook" class="button-link">Ajouter mon premier livre</a>
			{% else %}
				<p class="book-count">{{ books|length }} livre{% if books|length > 1 %}s{% endif %}</p>
				<table>
					<tr>
						<th>Titre</th>
						<th>Auteur</th>
						<th>Actions</th>
					</tr>
					{% for book in books %}
						<tr>
							<td>{{ book.title }}</td>
							<td>{{ book.author }}</td>
							<td>
								<a href="/updateBook/{{ book.id }}">Modifier</a>
								<form action="/deleteBook/{{ book.id }}" method="post" class="inline-form" onsubmit="return confirm('Supprimer ce livre ?')">
									<button type="submit" class="link-button">Supprimer</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</table>
			{% endif %}
		</section>
	</main>
{% endblock %}
